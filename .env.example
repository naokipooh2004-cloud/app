# =============================================================
# Postiz 環境変数テンプレート
# 使い方: このファイルを .env にコピーして値を編集してください。
#   cp .env.example .env
# .env は Git にコミットしないこと（.gitignore で除外済み）。
# =============================================================

# -------------------------------------------------------------
# 必須: JWT 署名用のシークレット
# 各環境で一意のランダム値を生成して設定すること。
#   openssl rand -base64 32
# -------------------------------------------------------------
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# -------------------------------------------------------------
# アクセス URL
# ローカルで試す場合はデフォルトのままで OK。
# 本番 / 外部公開する場合は、実際のドメイン（https）に変更する。
#   例: MAIN_URL=https://postiz.example.com
#       FRONTEND_URL=https://postiz.example.com
#       NEXT_PUBLIC_BACKEND_URL=https://postiz.example.com/api
# -------------------------------------------------------------
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api

# ホスト側に公開するポート（コンテナ内は常に 4007）
POSTIZ_PORT=4007

# -------------------------------------------------------------
# データベース（PostgreSQL）認証情報
# 本番では必ず強固なパスワードに変更すること。
# -------------------------------------------------------------
POSTGRES_USER=postiz-user
POSTGRES_PASSWORD=postiz-password
POSTGRES_DB=postiz-db-local

# -------------------------------------------------------------
# 新規ユーザー登録を無効化する場合は true にする。
# （最初のアカウントを作ったら true にすると安全）
# -------------------------------------------------------------
DISABLE_REGISTRATION=false
