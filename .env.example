# =============================================================
# FX Advisor API 環境変数テンプレート
#   cp .env.example .env  してから値を設定してください。
#   .env は Git にコミットされません（.gitignore 済み）。
# =============================================================

# サーバーの待ち受けポート
PORT=3000

# -------------------------------------------------------------
# AI チャット相談（/api/advice）に必須
# Anthropic のコンソールで発行した API キーを設定します。
#   https://console.anthropic.com/
# 未設定でも他の機能（分析・レート・カレンダー）は動作します。
# -------------------------------------------------------------
ANTHROPIC_API_KEY=

# AI アドバイザーが使うモデル（通常は変更不要）
ADVISOR_MODEL=claude-opus-5-5

# -------------------------------------------------------------
# 為替レートの取得元
#   frankfurter … 無料・キー不要（ECB 参照レート、日次）。既定。
#   mock         … 外部通信なし。デモ用のダミーデータを返す。
# ネットワークに出られない環境では mock を指定してください。
# -------------------------------------------------------------
RATES_PROVIDER=frankfurter

# frankfurter の API ベース URL（通常は変更不要）
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
